# 售卖机 ERP 生产环境变量模板(自带 MySQL 版)
# 用法:在 ECS /data/apps/vend/ 下复制为 .env,填真实值,chmod 600
#       .env 永不进 Git、永不进对话。AI 不代填/不经手明文密码。
# ⚠ 后端实际读取的变量名是 DB_URL / DB_USERNAME / DB_PASSWORD(见 application.yml),
#   不是 SPRING_DATASOURCE_*。compose 已把 DB_URL/USERNAME 拼好,这里只需给密码。

# ---- 数据库(编排内自带 mysql:8.0 容器,数据存 vend_mysql_data 卷)----
# DB_PASSWORD 同时用作 mysql root 密码 + 后端连库密码;上线时生成强随机值填入。
DB_PASSWORD=<生成强随机密码填入>
MYSQL_DATABASE=vend_prod

# ---- AI 网关(留空=全 mock 不外呼;填真 key 后在设置中心切真)----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 其他 ----
SSO_ENABLED=false
TZ=Asia/Shanghai

# 备注:
# · 结算模式(UNSET/PLATFORM/DIRECT)不在此配置——存数据库,上线后在「设置中心」一键切,默认 UNSET。
# · Flyway 首启自动从 V1.0.0→V1.0.17 建齐 40 表 + AI 视图 + 任务种子(空库无需手动 apply)。
