# 售卖机 ERP 生产环境变量模板(自带 MySQL 版)
# 用法:在 ECS /data/apps/vend/ 下复制为 .env,填真实值,chmod 600
#       .env 永不进 Git、永不进对话。AI 不代填/不经手明文密码。
# ⚠ 后端实际读取的变量名是 DB_URL / DB_USERNAME / DB_PASSWORD(见 application.yml),
#   不是 SPRING_DATASOURCE_*。compose 已把 DB_URL/USERNAME 拼好,这里只需给密码。

# ---- 数据库(编排内自带 mysql:8.0 容器,数据存 vend_mysql_data 卷)----
# DB_PASSWORD 同时用作 mysql root 密码 + 后端连库密码;上线时生成强随机值填入。
DB_PASSWORD=<生成强随机密码填入>
MYSQL_DATABASE=vend_prod

# ---- AI 网关(留空=全 mock 不外呼;填真 key 后在设置中心切真)----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 平台门户 SSO(aole-portal · 生态管理平台 eco.vvaix.com「点卡片免登直达」)----
# 开关:false 时 SSO 模块不生效(SsoController 不挂载),登录页只剩账号密码。
SSO_ENABLED=false
# 门户 API 根(含 /api)。本机 Docker 部署时门户跑在宿主 18151,容器内走 host.docker.internal:
#   SSO_PORTAL_BASE_URL=http://host.docker.internal:18151/api
# (Linux 宿主需在 compose 给 vend-server 加 extra_hosts: host.docker.internal:host-gateway;macOS Docker Desktop 自带)
SSO_PORTAL_BASE_URL=http://host.docker.internal:18151/api
# 由门户管理后台注册子系统时分配(yc_portal_system:app_id / client_secret),回调地址填 https://vend.vvaix.com/api/v1/sso/callback
# ⚠ 只放这里(chmod 600),永不入仓、永不进对话;AI 不代填。
SSO_APP_ID=<门户分配的 app_id>
SSO_CLIENT_SECRET=<门户分配的 client_secret>
# JWT issuer 多值兼容(ole-portal-sso 硬约束 1),一般不改
SSO_PORTAL_JWT_ISSUER=aole-portal,yunshan-portal
# 允许免登进本系统的门户租户 ID(逗号多值)。**缺省空 = 拒绝所有租户**(跨系统统一口径)。生态管理平台租户 = T000004
SSO_ALLOWED_TENANT_IDS=<门户租户ID,如 T000004>

# ---- 账号体系(2026-08-19 邀请码注册)----
# VEND_AUTH_SECRET=<openssl rand -hex 32>   # 会话 token HMAC 密钥,生产必配
# REGISTER_INVITE_CODE=dgsd1985
# REGISTER_DEFAULT_ROLE=店员                # SSO 首登建号也用这个最低角色

# ---- 其他 ----
TZ=Asia/Shanghai

# 备注:
# · 结算模式(UNSET/PLATFORM/DIRECT)不在此配置——存数据库,上线后在「设置中心」一键切,默认 UNSET。
# · Flyway 首启自动从 V1.0.0→V1.0.17 建齐 40 表 + AI 视图 + 任务种子(空库无需手动 apply)。
